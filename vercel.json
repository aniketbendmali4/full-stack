{
  "rewrites": [
    {
      "source": "/students",
      "destination": "https://full-stack-production-8a5c.up.railway.app/students"
    },
    {
      "source": "/students/(.*)",
      "destination": "https://full-stack-production-8a5c.up.railway.app/students/$1"
    },
    {
      "source": "/health",
      "destination": "https://full-stack-production-8a5c.up.railway.app/health"
    },
    {
      "source": "/docs",
      "destination": "https://full-stack-production-8a5c.up.railway.app/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://full-stack-production-8a5c.up.railway.app/openapi.json"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
